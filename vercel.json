{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/index.ts" },
    { "source": "/api/oauth/:path*", "destination": "/index.ts" },
    { "source": "/manus-storage/:path*", "destination": "/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
